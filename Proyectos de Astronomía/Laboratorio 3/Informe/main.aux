\newlabel{CMD}{{5}{4}{CMD mostrando el resultado obtenido por el método de optimización de parámetros. Se ve una buena pertenencia a la secuencia principal, con un par de miembros perdidos hacia la parte superior, todo para una probabilidad de 0.9 o más}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Histograma de probabilidad de pertenencia al cúmulo de interés, en escala logarítmica. La forma en U esperada se nota a pesar de la escala. }}{4}{figure.caption.6}\protected@file@percent }
\newlabel{ProbPert}{{6}{4}{Histograma de probabilidad de pertenencia al cúmulo de interés, en escala logarítmica. La forma en U esperada se nota a pesar de la escala}{figure.caption.6}{}}
