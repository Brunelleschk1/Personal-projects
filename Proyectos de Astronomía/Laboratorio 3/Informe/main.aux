\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Compilación de los CMDs obtenidos con el estudio de los datos mediante HDBSCAN. El cluster Messier 41 es, se espera, el cluster 1 tal y como lo marca el método.}}{2}{figure.caption.1}\protected@file@percent }
