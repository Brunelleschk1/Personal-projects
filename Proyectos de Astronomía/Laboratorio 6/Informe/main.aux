\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Curva de magnitud con respecto a fase de un sistema binario eclipsante tipo Algol con doble periodicidad. Se ve cómo la gráfica principal, a la izquierda, es la suma de dos variaciones periódicas, que se pueden separar. }}{3}{figure.caption.6}\protected@file@percent }
\newlabel{DoubleAlgol}{{6}{3}{Curva de magnitud con respecto a fase de un sistema binario eclipsante tipo Algol con doble periodicidad. Se ve cómo la gráfica principal, a la izquierda, es la suma de dos variaciones periódicas, que se pueden separar}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {2.1.2}Beta Lirae variables}{3}{subsubsection.2.1.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Curva de magnitud con respecto a fase de un sistema binario eclipsante tipo Beta Lyrae. Se nota, a comparación de un sistema Algol, que los eclipses y máximos se presentan como un continuo más que como dos funciones disyuntas.}}{3}{figure.caption.7}\protected@file@percent }
\newlabel{NormalBLyrae}{{7}{3}{Curva de magnitud con respecto a fase de un sistema binario eclipsante tipo Beta Lyrae. Se nota, a comparación de un sistema Algol, que los eclipses y máximos se presentan como un continuo más que como dos funciones disyuntas}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Curva de magnitud con respecto a fase de un sistema binario eclipsante tipo Beta Lyrea con efecto O'Connell. Se aprecia que el primer máximo en fase positiva es mayor al segundo, dando lugar a un efecto O'Connell positivo. El negativo invierte el orden, y es mucho más raro.}}{3}{figure.caption.8}\protected@file@percent }
\newlabel{OconBLyrae}{{8}{3}{Curva de magnitud con respecto a fase de un sistema binario eclipsante tipo Beta Lyrea con efecto O'Connell. Se aprecia que el primer máximo en fase positiva es mayor al segundo, dando lugar a un efecto O'Connell positivo. El negativo invierte el orden, y es mucho más raro}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {2.1.3}W Ursae Majoris}{3}{subsubsection.2.1.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Curva de magnitud con respecto a fase de un sistema binario eclipsante tipo W Ursae Majoris. Se ven los eclipses de impacto muy similar en la parte inferior del gráfico, así como los máximos de inicio y final de eclipse en la parte superior.}}{3}{figure.caption.9}\protected@file@percent }
\newlabel{NormalWUrsaeM}{{9}{3}{Curva de magnitud con respecto a fase de un sistema binario eclipsante tipo W Ursae Majoris. Se ven los eclipses de impacto muy similar en la parte inferior del gráfico, así como los máximos de inicio y final de eclipse en la parte superior}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}Estrellas variables pulsantes}{4}{subsection.2.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {2.2.1}Ceféidas clásicas}{4}{subsubsection.2.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Curva de magnitud con respecto a fase de una cefeida clásica en modo fundamental de oscilación. La progresión de Hertzprung es visible justo antes de un máximo. Suponemos que, puesto que el periodo aproxima los 20 días, ya nos encontramos del otro lado de la evolución de este fenómeno.}}{4}{figure.caption.10}\protected@file@percent }
\newlabel{NormalCefeid}{{10}{4}{Curva de magnitud con respecto a fase de una cefeida clásica en modo fundamental de oscilación. La progresión de Hertzprung es visible justo antes de un máximo. Suponemos que, puesto que el periodo aproxima los 20 días, ya nos encontramos del otro lado de la evolución de este fenómeno}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Curva de magnitud con respecto a fase de una cefeida clásica oscilando en el primer armónico. Vemos que no hay progresión de Herztprung y que la amplitud de la oscilación es menor que para una estrella en el modo fundamental.}}{4}{figure.caption.11}\protected@file@percent }
\newlabel{PrimerCefeid}{{11}{4}{Curva de magnitud con respecto a fase de una cefeida clásica oscilando en el primer armónico. Vemos que no hay progresión de Herztprung y que la amplitud de la oscilación es menor que para una estrella en el modo fundamental}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Curva de magnitud con respecto a fase de una cefeida clásica oscilando en el segundo armónico. La amplitud de la oscilación es muy pequeña, y la oscilación en sí es prácticamente sinusoidal.}}{4}{figure.caption.12}\protected@file@percent }
\newlabel{SecondCefeid}{{12}{4}{Curva de magnitud con respecto a fase de una cefeida clásica oscilando en el segundo armónico. La amplitud de la oscilación es muy pequeña, y la oscilación en sí es prácticamente sinusoidal}{figure.caption.12}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {2.2.2}RR Lyrae}{5}{subsubsection.2.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Curva de magnitud con respecto a fase de una estrella tipo RR Lyrae en su modo de oscilación fundamental. Se observa el comportamiento de ascención fuerte y descenso gradual.}}{5}{figure.caption.13}\protected@file@percent }
\newlabel{RRFundamental}{{13}{5}{Curva de magnitud con respecto a fase de una estrella tipo RR Lyrae en su modo de oscilación fundamental. Se observa el comportamiento de ascención fuerte y descenso gradual}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Curva de magnitud con respecto a fase de una estrella tipo RR Lyrae oscilando en el primer armónico. se ve una Línea gruesa, mostrando la diferencia de periodo a lo largo del periodo en el que se tomaron los datos. }}{5}{figure.caption.14}\protected@file@percent }
\newlabel{RRUno}{{14}{5}{Curva de magnitud con respecto a fase de una estrella tipo RR Lyrae oscilando en el primer armónico. se ve una Línea gruesa, mostrando la diferencia de periodo a lo largo del periodo en el que se tomaron los datos}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Curva de magnitud con respecto a fase de una estrella tipo RR Lyrae oscilando en una combinación de modo fundamental y primer armónico. Se observa la desconstrucción de la señal así como la variación de amplitud de la oscilación con el tiempo. }}{5}{figure.caption.15}\protected@file@percent }
\newlabel{RRUno}{{15}{5}{Curva de magnitud con respecto a fase de una estrella tipo RR Lyrae oscilando en una combinación de modo fundamental y primer armónico. Se observa la desconstrucción de la señal así como la variación de amplitud de la oscilación con el tiempo}{figure.caption.15}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {2.2.3}Mira}{5}{subsubsection.2.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Curva de magnitud con respecto a fase de una estrella tipo Mira rica en carbono. Se observan, a la izquierda, los datos tomados a lo largo del tiempo, y a la derecha los datos superpuestos para completar un ciclo de pulsaciones. Para una Mira rica en oxígeno, solo cambia la separación entre las líneas del gráfico derecho, siendo estas más uniandes y de cambios más intensos que las de carbono.}}{6}{figure.caption.16}\protected@file@percent }
\newlabel{MiraCarbon}{{16}{6}{Curva de magnitud con respecto a fase de una estrella tipo Mira rica en carbono. Se observan, a la izquierda, los datos tomados a lo largo del tiempo, y a la derecha los datos superpuestos para completar un ciclo de pulsaciones. Para una Mira rica en oxígeno, solo cambia la separación entre las líneas del gráfico derecho, siendo estas más uniandes y de cambios más intensos que las de carbono}{figure.caption.16}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {2.2.4}Variables Semiregulares}{6}{subsubsection.2.2.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Curva de magnitud con respecto a fase de una estrella pulsante semivariable. Se ve la dificultad de lecturas de un periodo o pico claro en amplitud, de ahí el nombre semivariable. Es importante notar que algunas estrellas son más claras que otras en cuanto a sus pulsaciones. Con los datos que se pueden tomar, que siempre son por periodos debido a la posición de la estrella en el universo y, a veces, al clima del observatorio, es aún más complejo observar estas estrellas.}}{6}{figure.caption.17}\protected@file@percent }
\newlabel{SRV}{{17}{6}{Curva de magnitud con respecto a fase de una estrella pulsante semivariable. Se ve la dificultad de lecturas de un periodo o pico claro en amplitud, de ahí el nombre semivariable. Es importante notar que algunas estrellas son más claras que otras en cuanto a sus pulsaciones. Con los datos que se pueden tomar, que siempre son por periodos debido a la posición de la estrella en el universo y, a veces, al clima del observatorio, es aún más complejo observar estas estrellas}{figure.caption.17}{}}
