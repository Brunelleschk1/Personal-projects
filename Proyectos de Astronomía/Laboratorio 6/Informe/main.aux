\newlabel{EccentricAlgol}{{2}{2}{Curva de magnitud con respecto a fase de un sistema binario eclipsante tipo Algol con órbitas eccéntricas}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Curva de magnitud con respecto a fase de un sistema binario eclipsante tipo Algol con movimiento aspidal. }}{2}{figure.caption.3}\protected@file@percent }
\newlabel{AspidalAlgol}{{3}{2}{Curva de magnitud con respecto a fase de un sistema binario eclipsante tipo Algol con movimiento aspidal}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Curva de magnitud con respecto a fase de un sistema binario eclipsante tipo Algol con efecto de reflexión. Se observa un efecto tan intenso que el eclipse secundario es prácticamente invisible.}}{2}{figure.caption.4}\protected@file@percent }
\newlabel{ReflexiónAlgol}{{4}{2}{Curva de magnitud con respecto a fase de un sistema binario eclipsante tipo Algol con efecto de reflexión. Se observa un efecto tan intenso que el eclipse secundario es prácticamente invisible}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Curva de magnitud con respecto a fase de un sistema binario eclipsante tipo Algol en el que una estrella posee un disco de acreción. Se observa como el eclipse primario es más largo que el secundario. }}{2}{figure.caption.5}\protected@file@percent }
\newlabel{AccretionAlgol}{{5}{2}{Curva de magnitud con respecto a fase de un sistema binario eclipsante tipo Algol en el que una estrella posee un disco de acreción. Se observa como el eclipse primario es más largo que el secundario}{figure.caption.5}{}}
