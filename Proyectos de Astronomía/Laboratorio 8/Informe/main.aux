\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Estrella 29 de las analizadas en OGLE. Se nota ruido alrededor de la frecuencia real de la estrella, y se ven caídas en la curva de luz que no parecen ser consistentes sobre todo el periodo de observación de la estrella.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{STAR29OGLE}{{1}{2}{Estrella 29 de las analizadas en OGLE. Se nota ruido alrededor de la frecuencia real de la estrella, y se ven caídas en la curva de luz que no parecen ser consistentes sobre todo el periodo de observación de la estrella}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Estrella 23 de las analizadas en OGLE. Se observa el ruido en las frecuencias del análisis de LS, así como una curva plegada poco clara y que parece más ruido que una verdadera estrella variable. }}{2}{figure.caption.2}\protected@file@percent }
\newlabel{STAR23OGLE}{{2}{2}{Estrella 23 de las analizadas en OGLE. Se observa el ruido en las frecuencias del análisis de LS, así como una curva plegada poco clara y que parece más ruido que una verdadera estrella variable}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Esta estrella, a lo largo de 2000 días, sólo aumentó en magnitud. LS le encuentra un periodo de un día, y pretende que su magnitud oscila. }}{2}{figure.caption.3}\protected@file@percent }
\newlabel{STAR41VVV}{{3}{2}{Esta estrella, a lo largo de 2000 días, sólo aumentó en magnitud. LS le encuentra un periodo de un día, y pretende que su magnitud oscila}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Estrella con una búsqueda de frecuencias llena de ruido, en la que no se puede discernir mucho. Su curva de luz plegada no dice nada sobre la estrella, y su curva de luz observada parece falta de datos.}}{2}{figure.caption.4}\protected@file@percent }
\newlabel{STAR12VVV}{{4}{2}{Estrella con una búsqueda de frecuencias llena de ruido, en la que no se puede discernir mucho. Su curva de luz plegada no dice nada sobre la estrella, y su curva de luz observada parece falta de datos}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Estrella con muy pocos datos de inicio. La búsqueda de LS es prácticamente solo ruido, ya que tiene picos de potencia similares en distintas partes del espectro de frecuencias. Su curva plegada parece coherente, pero viendo los resultados de LS, otro periodo hubiera hecho algo muy similar.}}{3}{figure.caption.5}\protected@file@percent }
\newlabel{STAR14VVV}{{5}{3}{Estrella con muy pocos datos de inicio. La búsqueda de LS es prácticamente solo ruido, ya que tiene picos de potencia similares en distintas partes del espectro de frecuencias. Su curva plegada parece coherente, pero viendo los resultados de LS, otro periodo hubiera hecho algo muy similar}{figure.caption.5}{}}
