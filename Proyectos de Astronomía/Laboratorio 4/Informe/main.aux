\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Resultados obtenidos para Hyades. Se observan una excelente distribución en distancia, una buena secuencia principal de CMD y una buena distribución de VPD}}{4}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{Hyades}{{1}{4}{Resultados obtenidos para Hyades. Se observan una excelente distribución en distancia, una buena secuencia principal de CMD y una buena distribución de VPD}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Distribución espacial en el mapa estelar del cúmulo 1 de la celda 44. Se observa una población repandida, como una simulación pequeña del cúmulo 3, encontrado más atrás en el espacio de esta misma celda. (Fig: ~ \ref {443})}}{4}{figure.caption.2}\protected@file@percent }
\newlabel{441}{{2}{4}{Distribución espacial en el mapa estelar del cúmulo 1 de la celda 44. Se observa una población repandida, como una simulación pequeña del cúmulo 3, encontrado más atrás en el espacio de esta misma celda. (Fig: ~ \ref {443})}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Distribución espacial en el mapa estelar del cúmulo 3 de la celda 44. Se observa una población compacta cerca a la esquina inferior izquierda, con algunos miembros perdidos hacia el centro de la celda. Cabe destacar que esta acumulación de estrellas se encuentra en la línea de la vía láctea, por lo cual la posibilidad de que se trate de un falso positivo aumenta considerablemente.}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{443}{{3}{5}{Distribución espacial en el mapa estelar del cúmulo 3 de la celda 44. Se observa una población compacta cerca a la esquina inferior izquierda, con algunos miembros perdidos hacia el centro de la celda. Cabe destacar que esta acumulación de estrellas se encuentra en la línea de la vía láctea, por lo cual la posibilidad de que se trate de un falso positivo aumenta considerablemente}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Resultados obtenidos para COMA(cluster 0). Se observan una excelente distribución en distancia, una buena secuencia principal de CMD y una buena distribución de VPD. Asimismo, se observa un segundo cluster que podría ser parte de COMA.}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{COMA}{{4}{5}{Resultados obtenidos para COMA(cluster 0). Se observan una excelente distribución en distancia, una buena secuencia principal de CMD y una buena distribución de VPD. Asimismo, se observa un segundo cluster que podría ser parte de COMA}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Mapa estelar en ascención recta y declinación. Las regiones 65 y 66 corresponden a Hyades y COMA, donde se observan unos cúmulos bien definidos.}}{5}{figure.caption.5}\protected@file@percent }
\newlabel{MapaGlobal}{{5}{5}{Mapa estelar en ascención recta y declinación. Las regiones 65 y 66 corresponden a Hyades y COMA, donde se observan unos cúmulos bien definidos}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Resultados obtenidos en el cuadrante 19. Se ve una gran cantidad de ruido e el CMD, así como una secuencia principal con muchos vacíos, pero una buena coherencia en el VPD. La distribución en distancia no tiene la forma gaussiana esperada, y supera los 30 parsecs de extensión. Está centrado cerca a los 85 parsecs de distancia.}}{5}{figure.caption.6}\protected@file@percent }
\newlabel{19}{{6}{5}{Resultados obtenidos en el cuadrante 19. Se ve una gran cantidad de ruido e el CMD, así como una secuencia principal con muchos vacíos, pero una buena coherencia en el VPD. La distribución en distancia no tiene la forma gaussiana esperada, y supera los 30 parsecs de extensión. Está centrado cerca a los 85 parsecs de distancia}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Resultados obtenidos en el cuadrante 20. Se observa una gran cantidad de ruido en el CMD, con pocos miembros que parecen reales, un VPD muy disperso y una distribución espacial de dos picos diferentes, poco coherentes para la distribución esperada de un cúmulo real. Está centrado hacia los 62 parsecs de distancia del sol.}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{20}{{7}{6}{Resultados obtenidos en el cuadrante 20. Se observa una gran cantidad de ruido en el CMD, con pocos miembros que parecen reales, un VPD muy disperso y una distribución espacial de dos picos diferentes, poco coherentes para la distribución esperada de un cúmulo real. Está centrado hacia los 62 parsecs de distancia del sol}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Resultados obtenidos en el cuadrante 44. Se observa una gran cantidad de ruido en el CMD para ambos cúmulos, aunque tienen una distribución coherente en el VPD. Sin embargo, el cúmulo 3 tiene una mala distribución en distancia, con muchos picos y valles, mientras que el primero goza de una distribución mejor. }}{6}{figure.caption.8}\protected@file@percent }
\newlabel{44}{{8}{6}{Resultados obtenidos en el cuadrante 44. Se observa una gran cantidad de ruido en el CMD para ambos cúmulos, aunque tienen una distribución coherente en el VPD. Sin embargo, el cúmulo 3 tiene una mala distribución en distancia, con muchos picos y valles, mientras que el primero goza de una distribución mejor}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Resultados obtenidos en el cuadrante 7. Vemos secuencias principales completas, con VPDs compactos. Sin embargo, es notable que el primer cúmulo presenta una buena distribución en distancia mientras que el cúmulo 0 parece estar esperando a la otra mitad de su población por fuera de los 100 pársecs.}}{6}{figure.caption.9}\protected@file@percent }
\newlabel{7}{{9}{6}{Resultados obtenidos en el cuadrante 7. Vemos secuencias principales completas, con VPDs compactos. Sin embargo, es notable que el primer cúmulo presenta una buena distribución en distancia mientras que el cúmulo 0 parece estar esperando a la otra mitad de su población por fuera de los 100 pársecs}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Resultados obtenidos para la región 14. Vemos un cúmulo con mucho ruido y huecos en la secuencia principal, un VPD compacto y una distribución en distancia con varios picos locales.}}{6}{figure.caption.10}\protected@file@percent }
\newlabel{14}{{10}{6}{Resultados obtenidos para la región 14. Vemos un cúmulo con mucho ruido y huecos en la secuencia principal, un VPD compacto y una distribución en distancia con varios picos locales}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Resultados obtenidos para la región 19. Se observa un CMD con mucho ruido y una secuencia principal poco poblada, así como una distribución en distancia superior a 30 pársecs con un par de picos locales cerca de los 95 y los 80 pársecs. }}{7}{figure.caption.11}\protected@file@percent }
\newlabel{19}{{11}{7}{Resultados obtenidos para la región 19. Se observa un CMD con mucho ruido y una secuencia principal poco poblada, así como una distribución en distancia superior a 30 pársecs con un par de picos locales cerca de los 95 y los 80 pársecs}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Resultados obtenidos para el cuadrante 20. Se observa una gran cantidad de ruido en el CMD, un VPD poco poblado y diversos picos en la distribución en distancia, cada vez mayores mientras crece la distancia.}}{7}{figure.caption.12}\protected@file@percent }
\newlabel{20}{{12}{7}{Resultados obtenidos para el cuadrante 20. Se observa una gran cantidad de ruido en el CMD, un VPD poco poblado y diversos picos en la distribución en distancia, cada vez mayores mientras crece la distancia}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Resultados obtenidos para el cuadrante 22. Se observa poco ruido en el CMD, con una buena secuencia principal, un VPD relativamente centrado, y una buena distribución en extensión, pegada a los 100 pársecs.}}{7}{figure.caption.13}\protected@file@percent }
\newlabel{22}{{13}{7}{Resultados obtenidos para el cuadrante 22. Se observa poco ruido en el CMD, con una buena secuencia principal, un VPD relativamente centrado, y una buena distribución en extensión, pegada a los 100 pársecs}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Resultados obtenidos para el cuadrante 25. El CMD tiene poco ruido, pero una secuencia principal gruesa. El VPD es disperso y la distribución en distancia es ascendente con algunos vacíos.}}{7}{figure.caption.14}\protected@file@percent }
\newlabel{25}{{14}{7}{Resultados obtenidos para el cuadrante 25. El CMD tiene poco ruido, pero una secuencia principal gruesa. El VPD es disperso y la distribución en distancia es ascendente con algunos vacíos}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Resultados obtenidos para el cuadrante 31. El CMD tiene muy poco ruido, y la secuencia principal es coherente, pero tiene picos locales y huecos en su distribución en distancia.}}{8}{figure.caption.15}\protected@file@percent }
\newlabel{31}{{15}{8}{Resultados obtenidos para el cuadrante 31. El CMD tiene muy poco ruido, y la secuencia principal es coherente, pero tiene picos locales y huecos en su distribución en distancia}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Resultados obtenidos para el cuadrante 39. Su CMD presenta poco ruido y una buena secuencia principal, con un VPD compacto y una distribución en distancia cercana a los 100 pársecs pero coherente con la de un cúmulo real. }}{8}{figure.caption.16}\protected@file@percent }
\newlabel{39}{{16}{8}{Resultados obtenidos para el cuadrante 39. Su CMD presenta poco ruido y una buena secuencia principal, con un VPD compacto y una distribución en distancia cercana a los 100 pársecs pero coherente con la de un cúmulo real}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Resultados obtenidos para el cuadrante 42. De secuencia principal gruesa y CMD con poco ruido, un VPD disperso pero coherente y una distribución en distancia que parece ser el principio de un cúmulo. }}{8}{figure.caption.17}\protected@file@percent }
\newlabel{42}{{17}{8}{Resultados obtenidos para el cuadrante 42. De secuencia principal gruesa y CMD con poco ruido, un VPD disperso pero coherente y una distribución en distancia que parece ser el principio de un cúmulo}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Resultados obtenidos para el cuadrante 44. Dos cúmulos que parecen estar compuestos por puro ruido e el CMD, aunque tengas VPDs compactos. La distribución en distancia del cúmulo 3 muestra una estructura con muchos picos y valles, mientras que la del primero muestra un histograma más coherente con el de un cúmulo real. }}{8}{figure.caption.18}\protected@file@percent }
\newlabel{44}{{18}{8}{Resultados obtenidos para el cuadrante 44. Dos cúmulos que parecen estar compuestos por puro ruido e el CMD, aunque tengas VPDs compactos. La distribución en distancia del cúmulo 3 muestra una estructura con muchos picos y valles, mientras que la del primero muestra un histograma más coherente con el de un cúmulo real}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Resultados obtenidos para el cuadrante 47. Con un poco de ruido, una secuencia principal gruesa y un VPD compacto. La distribución en distancia parece tener dos regiones principales de picos, en 85 y 97 pársecs. }}{9}{figure.caption.19}\protected@file@percent }
\newlabel{47}{{19}{9}{Resultados obtenidos para el cuadrante 47. Con un poco de ruido, una secuencia principal gruesa y un VPD compacto. La distribución en distancia parece tener dos regiones principales de picos, en 85 y 97 pársecs}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Resultados obtenidos para el cuadrante 48. una secuencia principal fina, con un VPD compacto y coherente, y una distribución en distancia con do regiones de picos , sobre 92 y 96 pársecs, con un valle entre medias. }}{9}{figure.caption.20}\protected@file@percent }
\newlabel{48}{{20}{9}{Resultados obtenidos para el cuadrante 48. una secuencia principal fina, con un VPD compacto y coherente, y una distribución en distancia con do regiones de picos , sobre 92 y 96 pársecs, con un valle entre medias}{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces Resultados obtenidos para el cuadrante 51. Presenta dos cúmulos que podrían ser uno de no ser por su separación en el VPD. Ambos tienen buen CMD y una distribución buena en distancia.}}{9}{figure.caption.21}\protected@file@percent }
\newlabel{51}{{21}{9}{Resultados obtenidos para el cuadrante 51. Presenta dos cúmulos que podrían ser uno de no ser por su separación en el VPD. Ambos tienen buen CMD y una distribución buena en distancia}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces Resultados obtenidos para el cuadrante 52. Con una secuencia principal poco poblada, pero con muy poco ruido en el CMD. Un VPD disperso y una distribución en distancia con valles y picos. }}{9}{figure.caption.22}\protected@file@percent }
\newlabel{52}{{22}{9}{Resultados obtenidos para el cuadrante 52. Con una secuencia principal poco poblada, pero con muy poco ruido en el CMD. Un VPD disperso y una distribución en distancia con valles y picos}{figure.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces Resultados obtenidos para el cuadrante 62. Presenta una secuencia principal con muchos huecos y un CMD con una cantidad de ruido no menor. Su VPD es medianamente compacto, y su distribución en distancia es muy buena.}}{10}{figure.caption.23}\protected@file@percent }
\newlabel{62}{{23}{10}{Resultados obtenidos para el cuadrante 62. Presenta una secuencia principal con muchos huecos y un CMD con una cantidad de ruido no menor. Su VPD es medianamente compacto, y su distribución en distancia es muy buena}{figure.caption.23}{}}
