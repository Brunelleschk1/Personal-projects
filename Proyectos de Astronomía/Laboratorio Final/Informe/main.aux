\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Histograma mostrando la distribución de diferencias promedio en magnitud entre mínimos. Aún con la escala logarítmica se aprecia que ninguna clase está por fuera del pico de las demás, por lo que esta feature tampoco sirve. El resultado entre máximos es muy similar a este.}}{3}{figure.caption.4}\protected@file@percent }
\newlabel{MinMin}{{4}{3}{Histograma mostrando la distribución de diferencias promedio en magnitud entre mínimos. Aún con la escala logarítmica se aprecia que ninguna clase está por fuera del pico de las demás, por lo que esta feature tampoco sirve. El resultado entre máximos es muy similar a este}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Histograma mostrando la distribución de skeeness por clase. Aunque la mayoría son similares, se nota que las estrellas binarias destacan del resto.}}{3}{figure.caption.5}\protected@file@percent }
\newlabel{Skew}{{5}{3}{Histograma mostrando la distribución de skeeness por clase. Aunque la mayoría son similares, se nota que las estrellas binarias destacan del resto}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Histograma mostrando la distribución de color por clase. Se ve que ninguna clase es igual, y que Others, aunque sangre a las demás clases, tiene su propio pico. Aunque no sea ideal que tenga varios, esto puede permitirnos pensar en las clases subyacentes de Others. }}{4}{figure.caption.6}\protected@file@percent }
\newlabel{Colores}{{6}{4}{Histograma mostrando la distribución de color por clase. Se ve que ninguna clase es igual, y que Others, aunque sangre a las demás clases, tiene su propio pico. Aunque no sea ideal que tenga varios, esto puede permitirnos pensar en las clases subyacentes de Others}{figure.caption.6}{}}
