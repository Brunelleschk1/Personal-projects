\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Histograma con la repartición de clases del dataset. De este ya se quitaron las cefeidas de tipo 2 y las anómalas, cada una con 5 y 2 miembros respectivamente. Estas clases luego se agruparon en binarias(eclipsantes y elipoidales), Long Period Variables, Pulsadoras radiales(RR Lyrae, Delta Scuti, D cepheid).}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{HistogramaClases}{{1}{2}{Histograma con la repartición de clases del dataset. De este ya se quitaron las cefeidas de tipo 2 y las anómalas, cada una con 5 y 2 miembros respectivamente. Estas clases luego se agruparon en binarias(eclipsantes y elipoidales), Long Period Variables, Pulsadoras radiales(RR Lyrae, Delta Scuti, D cepheid)}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Histograma mostrando la distribución de diferencias promedio entre mínimos y máximos de las estrellas. No hay ningún pico distinto de los demás, por lo que esta feature no nos conviene}}{3}{figure.caption.2}\protected@file@percent }
\newlabel{MinMax}{{2}{3}{Histograma mostrando la distribución de diferencias promedio entre mínimos y máximos de las estrellas. No hay ningún pico distinto de los demás, por lo que esta feature no nos conviene}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Histograma mostrando la distribución de diferencias promedio en fase entre máximos y mínimos de las estrellas. Se ve que el pico de estrellas pulsantes difiere del resto, por lo que esta feature, aunque no sea tan definitiva como otras. nos puede servir.}}{3}{figure.caption.3}\protected@file@percent }
\newlabel{MaxMin}{{3}{3}{Histograma mostrando la distribución de diferencias promedio en fase entre máximos y mínimos de las estrellas. Se ve que el pico de estrellas pulsantes difiere del resto, por lo que esta feature, aunque no sea tan definitiva como otras. nos puede servir}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Histograma mostrando la distribución de diferencias promedio en magnitud entre mínimos. Aún con la escala logarítmica se aprecia que ninguna clase está por fuera del pico de las demás, por lo que esta feature tampoco sirve. El resultado entre máximos es muy similar a este.}}{3}{figure.caption.4}\protected@file@percent }
\newlabel{MinMin}{{4}{3}{Histograma mostrando la distribución de diferencias promedio en magnitud entre mínimos. Aún con la escala logarítmica se aprecia que ninguna clase está por fuera del pico de las demás, por lo que esta feature tampoco sirve. El resultado entre máximos es muy similar a este}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Histograma mostrando la distribución de skewness por clase. Aunque la mayoría son similares, se nota que las estrellas binarias destacan del resto.}}{3}{figure.caption.5}\protected@file@percent }
\newlabel{Skew}{{5}{3}{Histograma mostrando la distribución de skewness por clase. Aunque la mayoría son similares, se nota que las estrellas binarias destacan del resto}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Histograma mostrando la distribución de color por clase. Se ve que ninguna clase es igual, y que Others, aunque sangre a las demás clases, tiene su propio pico. Aunque no sea ideal que tenga varios, esto puede permitirnos pensar en las clases subyacentes de Others. }}{3}{figure.caption.6}\protected@file@percent }
\newlabel{Colores}{{6}{3}{Histograma mostrando la distribución de color por clase. Se ve que ninguna clase es igual, y que Others, aunque sangre a las demás clases, tiene su propio pico. Aunque no sea ideal que tenga varios, esto puede permitirnos pensar en las clases subyacentes de Others}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Machine Learning}{4}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Matriz de confusión del testeo de un grupo de poco más de mil estrellas después de un entrenamiento Con más de cinco mil. Vemos que la predicción que más errores dió fue predecir que era una Other cuando se trataba de una binaria, y que las pulsantes y LPVs fueron muy bien predichas.}}{4}{figure.caption.7}\protected@file@percent }
\newlabel{CM8020}{{7}{4}{Matriz de confusión del testeo de un grupo de poco más de mil estrellas después de un entrenamiento Con más de cinco mil. Vemos que la predicción que más errores dió fue predecir que era una Other cuando se trataba de una binaria, y que las pulsantes y LPVs fueron muy bien predichas}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Matriz de confusión del testeo de un grupo de más de cinco mil estrellas, con un entrenamiento de unas mil. Una vez más, es de resultados bastante lineares, donde lo más notable es la confusión entre binarias y others, y las confusiones de varios tipos con binarias.}}{4}{figure.caption.8}\protected@file@percent }
\newlabel{CM2080}{{8}{4}{Matriz de confusión del testeo de un grupo de más de cinco mil estrellas, con un entrenamiento de unas mil. Una vez más, es de resultados bastante lineares, donde lo más notable es la confusión entre binarias y others, y las confusiones de varios tipos con binarias}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Importancia de cada feature en la clasificación del testing de 1000 estrellas. Se ve una clara dominación del color, y vemos que el periodo no resulta ser tan efectivo como lo esperábamos al iniciar el laboratorio. Con nuestras espectativas después de calcularlo sin discriminación, este resultado es más lógico.}}{4}{figure.caption.9}\protected@file@percent }
\newlabel{Imp8020}{{9}{4}{Importancia de cada feature en la clasificación del testing de 1000 estrellas. Se ve una clara dominación del color, y vemos que el periodo no resulta ser tan efectivo como lo esperábamos al iniciar el laboratorio. Con nuestras espectativas después de calcularlo sin discriminación, este resultado es más lógico}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Importancia de cada feature en la clasificación del testing de 5000 estrellas. Skewness y La diferencia entre máximos y mínimos cobra mucha importancia cuando el modelo no sabe a ciencia cierta que con color puede discernir los grupos mucho mejor. Se ve que la idea original del autor sirve un propósito, aunque este decaiga con el entrenamiento correcto del modelo.}}{4}{figure.caption.10}\protected@file@percent }
\newlabel{Imp2080}{{10}{4}{Importancia de cada feature en la clasificación del testing de 5000 estrellas. Skewness y La diferencia entre máximos y mínimos cobra mucha importancia cuando el modelo no sabe a ciencia cierta que con color puede discernir los grupos mucho mejor. Se ve que la idea original del autor sirve un propósito, aunque este decaiga con el entrenamiento correcto del modelo}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Distribución de confianza de la clasificación de 1000 estrellas testeadas, en escala logarítmica vertical. Se ve una clara tendencia a tener estrellas con una clasificación de alta confianza. }}{5}{figure.caption.11}\protected@file@percent }
\newlabel{Conf8020}{{11}{5}{Distribución de confianza de la clasificación de 1000 estrellas testeadas, en escala logarítmica vertical. Se ve una clara tendencia a tener estrellas con una clasificación de alta confianza}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Distribución de confianza de la clasificación de 5000 estrellas testeadas, en escala logarítmica vertical. Se ve una tendencia hacia las probabilidades altas de buena clasificación, aunque la cola de probabilidades inferiores se empieza a llenar bastante. }}{5}{figure.caption.12}\protected@file@percent }
\newlabel{Conf2080}{{12}{5}{Distribución de confianza de la clasificación de 5000 estrellas testeadas, en escala logarítmica vertical. Se ve una tendencia hacia las probabilidades altas de buena clasificación, aunque la cola de probabilidades inferiores se empieza a llenar bastante}{figure.caption.12}{}}
